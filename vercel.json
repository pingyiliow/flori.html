{
  "rewrites": [
    {
      "source": "/",
      "destination": "/flori.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/flori.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/order.html",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/invoice.html",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/order",
      "has": [{ "type": "query", "key": "t", "value": "(?<t>[A-Za-z0-9_-]+)" }],
      "destination": "https://bambooflorist.com.my/order?t=:t",
      "permanent": false
    },
    {
      "source": "/order.html",
      "has": [{ "type": "query", "key": "t", "value": "(?<t>[A-Za-z0-9_-]+)" }],
      "destination": "https://bambooflorist.com.my/order?t=:t",
      "permanent": false
    },
    {
      "source": "/s/:path*",
      "destination": "https://bambooflorist.com.my/:path*",
      "permanent": false
    }
  ]
}
